{
  "name": "senseguard/senseguard-pi",
  "description": "SenseGuard - gestão de manutenção industrial com monitoramento de sensores.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.50",
    "phpstan/phpstan": "^1.11"
  },
  "autoload": {
    "psr-4": { "SenseGuard\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "SenseGuard\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "php tests/run.php",
    "analyse": "phpstan analyse -c phpstan.neon.dist",
    "cs": "php-cs-fixer fix --dry-run --diff"
  }
}
